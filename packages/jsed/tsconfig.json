{
  "compilerOptions": {
    // Required
    // See https://www.typescriptlang.org/docs/handbook/modules/guides/choosing-compiler-options.html#im-using-a-bundler
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    // Consult your bundler’s documentation
    "customConditions": ["module"],
    // Recommended
    "noEmit": true, // or `emitDeclarationOnly`
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true, // or `isolatedModules`
    //
    //
    // "Not" required:
    "skipLibCheck": true,
    "target": "ES2020",
    // ES2022.Intl is types only - it declares Intl.Segmenter, used by
    // SYNTACTIC_SPLIT to iterate grapheme clusters. Target stays ES2020.
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "../../apps/jsed-demo/src/lib/oneput/app/Root.ts",
    "../../apps/jsed-demo/src/lib/oneput/app/_layout.ts"
  ]
  // "exclude": ["src/**/*.test.ts"]
}
